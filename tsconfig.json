{
  "extends": "../../Toolchain/tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@util/*": [
        "../../Toolchain/util/*"
      ],
      "*": [
        "../../Toolchain/node_modules/*"
      ]
    },
    "typeRoots": [
      "../../Toolchain/node_modules/@types",
      "../../Toolchain/node_modules"
    ]
  },
  "include": [
    "src",
    "*.d.ts",
    "../../Toolchain/@types"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
